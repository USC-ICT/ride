<?xml version="1.0" encoding="utf-8" ?> 

<rule_input>
<project>VHTOOLKIT</project>

<nvb_rules>

	<!-- This file lays out the communicative derivation from the surface text --> 

	<!-- *********************************** NON-ANIMATIONS ********************************** -->
	<rule keyword="first_NP" priority="5" >
		<pattern>first_NP</pattern>
	</rule>

	<rule keyword="noun_phrase" priority="5" >
		<pattern>NP</pattern>
	</rule>

	<rule keyword="interjection" priority="1" >
		<pattern>INTJ</pattern>
	</rule>

	<!-- affirmation -->
	<rule keyword="affirmation" priority="2" >
		<pattern>yes</pattern>
		<pattern>yeah</pattern>
		<pattern>yes,</pattern>
	</rule>
	
	<!-- inclusivity -->
	<rule keyword="inclusivity" priority="4" >
		<pattern>everything</pattern>
		<pattern>all</pattern>
		<pattern>whole</pattern>
		<pattern>plenty</pattern>
		<pattern>full</pattern>
		<pattern>completely</pattern>
	</rule>
	
	<!-- intensification -->
	<rule keyword="intensification" priority="4" >
		<pattern>really</pattern>
		<pattern>very</pattern>
		<pattern>quite</pattern>		
		<pattern>wonderful</pattern>
		<pattern>great</pattern>
		<pattern>absolutely</pattern>
		<pattern>huge</pattern>
		<pattern>fantastic</pattern>
		<pattern>so</pattern>
		<pattern>amazing</pattern>
		<pattern>important</pattern>
	</rule>
	
	<!-- emo_positive -->
	<rule keyword="emo_positive" priority="1" >
		<pattern>good</pattern>
		<pattern>nice</pattern>
		<pattern>great</pattern>
	</rule>

  <!--   idle gaze behavior  -->
  <rule keyword="idle_gaze" priority="1" >
    <pattern>DOWNLEFT</pattern>
    <pattern>DOWNRIGHT</pattern>
    <pattern>POLAR 0</pattern>
  </rule>

	<!-- *********************************** ANIMATIONS ********************************** -->
	
	<!--   you animation  -->
	<rule keyword="you_animation" priority="5" >
		<pattern>you</pattern>
		<pattern>your</pattern>
		<pattern>yours</pattern>
		<animation>
			<posture name="Standing01">
				<clip>Standing01_YouLf01</clip>
				<clip>Standing01_BeatLowLf01</clip>
				<clip>Standing01_BeatMidLf01</clip>
			</posture>
			<posture name="ChrGenericMleAdult@IdleStandingUpright01">
				<clip>IdleStandingUpright01_YouLf01</clip>
				<clip>IdleStandingUpright01_BeatLowLf01</clip>
			</posture>
			<posture name="CC@IdleStandingUpright01">
				<clip>CC_IdleStandingUpright01_YouLf01</clip>
				<clip>CC_IdleStandingUpright01_BeatLowLf01</clip>
			</posture>
			<posture name="OG_IdleStandingUpright01">
				<clip>OG_IdleStandingUpright01_YouLf01</clip>
				<clip>OG_IdleStandingUpright01_BeatLowLf01</clip>
			</posture>
			<posture name="ChrGenericMleAdult@IdleSittingUpright01">
				<clip>IdleSittingUpright01_IndicateSmLf01</clip>
				<clip>IdleSittingUpright01_IndicateSmRt01</clip>
				<clip>IdleSittingUpright01_PointSmLf01</clip>
				<clip>IdleSittingUpright01_PointSmRt01</clip>
				<clip>IdleSittingUpright01_SingleTapSmLf01</clip>
				<clip>IdleSittingUpright01_SingleTapSmRt01</clip>
			</posture>
		</animation>
	</rule>
	
	<!--   me animation  -->
	<rule keyword="me_animation" priority="5" >
		<pattern>i</pattern> 
		<pattern>me</pattern>
		<pattern>my</pattern>
		<pattern>mine</pattern>		
		<animation>
			<posture name="Standing01">
				<clip>Standing01_MeLf03</clip>
				<clip>Standing01_MeRt03</clip>
				<clip>Standing01_BeatLowRt01</clip>
				<clip>Standing01_BeatMidRt01</clip>
			</posture>
			<posture name="ChrGenericMleAdult@IdleStandingUpright01">
				<clip>IdleStandingUpright01_MeLf01</clip>
				<clip>IdleStandingUpright01_BeatLowRt01</clip>
			</posture>
			<posture name="CC@IdleStandingUpright01">
				<clip>CC_IdleStandingUpright01_MeLf01</clip>
				<clip>CC_IdleStandingUpright01_BeatLowRt01</clip>
			</posture>
			<posture name="OG_IdleStandingUpright01">
				<clip>OG_IdleStandingUpright01_MeLf01</clip>
				<clip>OG_IdleStandingUpright01_BeatLowRt01</clip>
			</posture>
			<posture name="ChrGenericMleAdult@IdleSittingUpright01">
				<clip>IdleSittingUpright01_SelfMedLf01</clip>
			</posture>
		</animation>
	</rule>
	
	<rule keyword="statement_animation" priority="2" >
		<pattern>is</pattern>
		<pattern>are</pattern>
		<pattern>were</pattern>
		<pattern>was</pattern>
		<pattern>have been</pattern>
		<pattern>has been</pattern>
		<pattern>at</pattern>
		<pattern>stands</pattern>
		<pattern>come</pattern>
		<pattern>like</pattern>
		<animation>
			<posture name="Standing01">
				<clip>Standing01_ChopLf01</clip>
				<clip>Standing01_ChopRt01</clip>
			</posture>
			<posture name="ChrGenericMleAdult@IdleStandingUpright01">
				<clip>IdleStandingUpright01_ChopLf01</clip>
				<clip>IdleStandingUpright01_BeatLowBt01</clip>
			</posture>
			<posture name="CC@IdleStandingUpright01">
				<clip>CC_IdleStandingUpright01_ChopLf01</clip>
				<clip>CC_IdleStandingUpright01_BeatLowBt01</clip>
			</posture>
			<posture name="OG_IdleStandingUpright01">
				<clip>OG_IdleStandingUpright01_ChopLf01</clip>
				<clip>OG_IdleStandingUpright01_BeatLowBt01</clip>
			</posture>
			<posture name="ChrGenericMleAdult@IdleSittingUpright01">
				<clip>IdleSittingUpright01_SingleTapSmLf01</clip>
				<clip>IdleSittingUpright01_SingleTapSmRt01</clip>
			</posture>
		</animation>
	</rule>
		
	<!--   negation animation  -->
	<rule keyword="negation_animation" priority="2" >
		<pattern>no</pattern>
		<pattern>not</pattern>
		<pattern>nothing</pattern>
		<pattern>cannot</pattern>
		<pattern>can't</pattern>
		<pattern>cant</pattern>
		<pattern>don't</pattern>
		<pattern>dont</pattern>
		<pattern>didn't</pattern>
		<pattern>couldn't</pattern>
		<pattern>couldnt</pattern>
		<pattern>isn't</pattern>
		<pattern>isnt</pattern>
		<pattern>wasn't</pattern>
		<pattern>wasnt</pattern>
		<animation>
			<posture name="Standing01">
				<clip>Standing01_Shrug01</clip>
			</posture>
			<posture name="ChrGenericMleAdult@IdleStandingUpright01">
				<clip>IdleStandingUpright01_NegativeRt01</clip>
				<clip>IdleStandingUpright01_Shrug01</clip>
			</posture>
			<posture name="CC@IdleStandingUpright01">
				<clip>CC_IdleStandingUpright01_NegativeRt01</clip>
				<clip>CC_IdleStandingUpright01_Shrug01</clip>
			</posture>
			<posture name="OG_IdleStandingUpright01">
				<clip>OG_IdleStandingUpright01_NegativeRt01</clip>
				<clip>OG_IdleStandingUpright01_Shrug01</clip>
			</posture>
			<posture name="ChrGenericMleAdult@IdleSittingUpright01">
				<clip>IdleSittingUpright01_AllTapSmLf01</clip>
				<clip>IdleSittingUpright01_AllTapSmRt01</clip>
				<clip>IdleSittingUpright01_EmptyMedBt01</clip>
				<clip>IdleSittingUpright01_EmptyMedBt02</clip>
				<clip>IdleSittingUpright01_EmptyMedLf01</clip>
				<clip>IdleSittingUpright01_EmptySmBt01</clip>
			</posture>
		</animation>
	</rule>
	
	<!--   contrast animation  -->
	<rule keyword="contrast_animation" priority="4" >
		<pattern>but</pattern>
		<pattern>however</pattern>
		<animation>
			<posture name="Standing01">
				<clip>Standing01_HoweverLf01</clip>
			</posture>
			<posture name="ChrGenericMleAdult@IdleStandingUpright01">
				<clip>IdleStandingUpright01_HoweverLf01</clip>
			</posture>
			<posture name="CC@IdleStandingUpright01">
				<clip>CC_IdleStandingUpright01_HoweverLf01</clip>
			</posture>
			<posture name="OG_IdleStandingUpright01">
				<clip>OG_IdleStandingUpright01_HoweverLf01</clip>
			</posture>
			<posture name="ChrGenericMleAdult@IdleSittingUpright01">
				<clip>IdleSittingUpright01_SingleTapSmLf01</clip>
				<clip>IdleSittingUpright01_SingleTapSmRt01</clip>
				<clip>IdleSittingUpright01_IndicateSmLf01</clip>
				<clip>IdleSittingUpright01_IndicateSmRt01</clip>
				<clip>IdleSittingUpright01_DiscardMedLf01</clip>
			</posture>
		</animation>
	</rule>	
	
	<!--   assumption animation  -->
	<rule keyword="assumption_animation" priority="3">
		<pattern>maybe</pattern>
		<pattern>perhaps</pattern>
		<animation>
			<posture name="Standing01">
				<clip>Standing01_Shrug01</clip>
			</posture>
			<posture name="ChrGenericMleAdult@IdleStandingUpright01">
				<clip>IdleStandingUpright01_Shrug01</clip>
			</posture>
			<posture name="CC@IdleStandingUpright01">
				<clip>CC_IdleStandingUpright01_Shrug01</clip>
			</posture>
			<posture name="OG_IdleStandingUpright01">
				<clip>OG_IdleStandingUpright01_Shrug01</clip>
			</posture>
			<posture name="ChrGenericMleAdult@IdleSittingUpright01">
				<clip>IdleSittingUpright01_FrontMedLf01</clip>
				<clip>IdleSittingUpright01_FrontSmRt01</clip>
			</posture>
		</animation>
	</rule>
	
	<!--   rhetorical animation  -->
	<rule keyword="rhetorical_animation" priority="2" >
		<pattern>why</pattern>
		<animation>
			<posture name="Standing01">
				<clip>Standing01_Shrug01</clip>
			</posture>
			<posture name="ChrGenericMleAdult@IdleStandingUpright01">
				<clip>IdleStandingUpright01_Shrug01</clip>
			</posture>
			<posture name="CC@IdleStandingUpright01">
				<clip>CC_IdleStandingUpright01_Shrug01</clip>
			</posture>
			<posture name="OG_IdleStandingUpright01">
				<clip>OG_IdleStandingUpright01_Shrug01</clip>
			</posture>
			<posture name="ChrGenericMleAdult@IdleSittingUpright01">
				<clip>IdleSittingUpright01_ShrugSm01</clip>
				<clip>IdleSittingUpright01_ShrugSm02</clip>
				<clip>IdleSittingUpright01_ShrugSm03</clip>
			</posture>
		</animation>
	</rule>

	<!--   question animation  -->
	<rule keyword="question_animation" priority="1">
		<pattern>where</pattern>
		<pattern>who</pattern>
		<pattern>how</pattern>
		<pattern>when</pattern>
		<pattern>do</pattern>
		<animation>
			<posture name="Standing01">
				<clip>Standing01_Shrug01</clip>
			</posture>
			<posture name="ChrGenericMleAdult@IdleStandingUpright01">
				<clip>IdleStandingUpright01_Shrug01</clip>
			</posture>
			<posture name="CC@IdleStandingUpright01">
				<clip>CC_IdleStandingUpright01_Shrug01</clip>
			</posture>
			<posture name="OG_IdleStandingUpright01">
				<clip>OG_IdleStandingUpright01_Shrug01</clip>
			</posture>
			<posture name="ChrGenericMleAdult@IdleSittingUpright01">
				<clip>IdleSittingUpright01_LeftMedLf01</clip>
				<clip>IdleSittingUpright01_IndicateSmRt01</clip>
				<clip>IdleSittingUpright01_IndicateSmLf01</clip>
			</posture>
		</animation>
	</rule>

	<!--   deictic animation  -->
	<rule keyword="deictic_animation" priority="5">
