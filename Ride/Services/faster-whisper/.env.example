# Bearer token required for /transcribe. Leave empty to disable auth.
API_TOKEN=

# Whisper model size. Options: tiny, tiny.en, base, base.en, small, small.en, medium, medium.en, large-v3
# Smaller = faster but less accurate. .en variants are English-only but slightly better for English.
MODEL_SIZE=medium

# Device: cuda (GPU, recommended) or cpu (slow for large models).
DEVICE=cuda

# Compute precision. float16 is fastest on modern GPUs; int8 for memory-constrained; float32 for CPU.
COMPUTE_TYPE=float16

# Default transcription language (ISO 639-1 code, e.g. en, fr, de). Leave empty to auto-detect.
DEFAULT_LANGUAGE=en

# Apply voice activity detection to filter silence. Reduces hallucinations on quiet audio.
DEFAULT_VAD_FILTER=true
