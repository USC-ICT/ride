# Two models pre-pulled at startup and kept resident for instant hot-swap. Any Ollama library name works.
# Keep them Apache/MIT-licensed if you plan to redistribute a baked image. Examples:
#   qwen3:0.6b  qwen3:1.7b  qwen3:4b  qwen3:8b   (Apache-2.0)
#   phi4-mini   (MIT)   |   gemma3:1b  gemma3:4b   |   llama3.2
OLLAMA_MODEL_A=phi4-mini
OLLAMA_MODEL_B=qwen3:1.7b

# Embedding model, pulled at startup only when set. Required for semantic retrieval; leave it
# empty for a plain LLM setup. load-with-rag.bat sets this for you.
#OLLAMA_MODEL_EMBED=nomic-embed-text

# Port the container listens on. 11434 is Ollama's canonical port, which clients expect.
# Only change this if you run the RIDE RAG proxy (../rag-proxy): the proxy takes 11434 so
# clients transparently gain retrieval, and Ollama moves aside - set OLLAMA_PORT=11436 then.
OLLAMA_PORT=11434
