<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RagProxy</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- The RIDE package retrieval sources, compiled directly: one retrieval
         implementation shared by the Unity runtime, the eval harness, and this proxy. -->
    <Compile Include="..\..\RideUnity\Packages\edu.usc.ict.ride.abstract\Runtime\Interfaces\Cognition\IKnowledgeSystem.cs" />
    <Compile Include="..\..\RideUnity\Packages\edu.usc.ict.ride.cognition\Runtime\Knowledge\KnowledgeIndex.cs" />
  </ItemGroup>
</Project>
