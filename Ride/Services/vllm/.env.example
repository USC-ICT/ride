HF_TOKEN=your_huggingface_token_here

# Bearer token for the /v1/* endpoints. Change for production; keep default for local dev.
VLLM_API_KEY=local-dev-token

# Where to store downloaded models. Default is ~/.cache/huggingface (usually C: on Windows).
# If C: is low on space, point this at a drive with at least 10 GB free.
# Windows example: HF_CACHE_PATH=D:/.cache/huggingface
#HF_CACHE_PATH=D:/.cache/huggingface

# Model to serve. Change and run "docker compose up -d --build" to switch.
#
# WSL2 constraint: vLLM only works with models that use the V1 model runner.
# Qwen3 (Qwen3ForCausalLM) triggers the V2 runner which requires UVA -- not available on WSL2.
# On native Linux, any model works.
#
# Phi-4-mini  = MIT license, commercial use OK; 3.8B, 7.69 GB; V1 runner expected (default)
# Qwen2.5     = non-commercial only (Qwen Research license); works on WSL2
# Qwen3       = Apache-2.0, commercial use OK; WSL2: use Ollama; native Linux: works here
# Gemma 4 E2B = Gemma Terms of Use, commercial use OK; gated (HF token must have access granted);
#               uses V1 runner (WSL2 compatible); checkpoint is 9.54 GiB -- fails even at
#               --max-model-len 2048 on 12 GB WSL2 (model weights + CUDA graphs exceed budget);
#               may fit on native Linux with 12 GB
VLLM_MODEL=microsoft/Phi-4-mini-instruct
#VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct
#VLLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
#VLLM_MODEL=google/gemma-4-E2B-it

# Embedding model for semantic retrieval, served on port 8001 as "vhtoolkit-embed" by a second
# container. Only started in the "rag" profile (load-with-rag.bat) - a plain LLM setup ignores it.
# bge-small-en-v1.5 = MIT, 133M, English only. Alternatives: intfloat/e5-small-v2 (MIT),
# BAAI/bge-m3 (multilingual, much larger).
VLLM_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Share of GPU memory for the embeddings container. The chat service takes 0.90 by default, so
# on a single card the two together will not fit -- lower the chat service's
# --gpu-memory-utilization in entrypoint.sh (roughly 0.75) before running both.
VLLM_EMBED_GPU_FRACTION=0.10
